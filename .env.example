# 本地开发。复制为 .env，生产必须按 docs/deployment.md 配置。
APP_ENV=development
DATABASE_URL=sqlite:///./var/jianwai.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_WEB_URL=http://localhost:5173
COOKIE_SECURE=false
